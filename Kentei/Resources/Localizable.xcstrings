    "onboarding.audio.help.body": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa volume dan sakelar senyap perangkat. Jika masih tidak terdengar, tambahkan suara bahasa Indonesia melalui Pengaturan → Aksesibilitas → Konten Lisan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の音量と消音スイッチを確認してください。それでも聞こえない場合は、設定アプリの「アクセシビリティ」→「読み上げコンテンツ」からインドネシア語の音声を追加してください。"
          }
        }
      }
    },
