{
  "sourceLanguage": "ja",
  "strings": {
    "interview.topicRule": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1トピック・最大3回答。合格ラインなら掘り下げ、下回った時点で終了します。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu topik, maksimal tiga jawaban. Jika memenuhi batas lulus, lanjut ke pertanyaan pendalaman; jika tidak, topik berakhir."
          }
        }
      }
    },
    "interview.turn.1": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問 1 / 最大3問"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertanyaan 1 / maksimal 3"
          }
        }
      }
    },
    "interview.turn.2": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "掘り下げ 1 / 2"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendalaman 1 / 2"
          }
        }
      }
    },
    "interview.turn.3": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "掘り下げ 2 / 2"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendalaman 2 / 2"
          }
        }
      }
    },
    "interview.next": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "掘り下げの質問へ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjut ke pertanyaan pendalaman"
          }
        }
      }
    },
    "interview.followupReady": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合格ラインです。もう少し詳しく聞かせてください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban memenuhi batas lulus. Mari kita bahas lebih dalam."
          }
        }
      }
    },
    "interview.topicPassed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このトピックは合格です"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Topik ini lulus"
          }
        }
      }
    },
    "interview.topicFailed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このトピックは不合格です。講評を見て練習しましょう。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Topik ini belum lulus. Pelajari umpan balik, lalu berlatih lagi."
          }
        }
      }
    },
    "interview.practiceNotice": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはアプリ内の練習判定で、公式試験の合否ではありません。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini hasil latihan di aplikasi, bukan hasil ujian resmi."
          }
        }
      }
    },
    "oral.error.assessment": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "採点できませんでした。不合格にはしていません。回答は保存済みです。もう一度提出してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penilaian belum berhasil. Anda tidak dinyatakan gagal. Jawaban tersimpan; silakan kirim lagi."
          }
        }
      }
    },
    "interview.followup.b.1": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今の回答で提案した対策を、上司にどのように説明しますか。実際に話すつもりで、丁寧に伝えてください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagaimana Anda menjelaskan solusi yang baru Anda usulkan kepada atasan? Sampaikan secara sopan, seolah-olah Anda sedang berbicara langsung dengannya."
          }
        }
      }
    },
    "interview.followup.b.2": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それでも上司が期限を変更できないと言ったら、どうしますか。別の対応策と、その理由を説明してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika atasan tetap mengatakan bahwa tenggat waktu tidak dapat diubah, apa yang akan Anda lakukan? Jelaskan alternatif lain dan alasannya."
          }
        }
      }
    },
    "interview.followup.a.1": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今の回答で提案した対策によって、チームの連携が改善したとどのように判断しますか。具体的な指標を挙げて説明してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagaimana Anda menilai apakah solusi yang baru Anda usulkan benar-benar memperbaiki kerja sama tim? Jelaskan dengan indikator yang konkret."
          }
        }
      }
    },
    "interview.followup.a.2": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その対策には費用がかかりすぎるという反論が出たら、どう答えますか。効果と費用の両面から説明してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ada yang berpendapat bahwa solusi tersebut terlalu mahal, bagaimana Anda menanggapinya? Jelaskan dengan mempertimbangkan manfaat dan biayanya."
          }
        }
      }
    },
    "interview.title.voice": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "面接：音声で回答"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Wawancara: jawaban lisan"
          }
        }
      }
    },
    "interview.title.written": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "面接：文字で回答"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Wawancara: jawaban tertulis"
          }
        }
      }
    },
    "interview.detail.voice": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問音声を聞いて、声で回答します"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengarkan pertanyaan, lalu jawab dengan suara"
          }
        }
      }
    },
    "interview.detail.written": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問音声を聞いて、文字で回答します"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengarkan pertanyaan, lalu ketik jawaban"
          }
        }
      }
    },
    "interview.instructions": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "面接官の質問を聞いて、インドネシア語で答えましょう。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengarkan pertanyaan pewawancara, lalu jawab dalam bahasa Indonesia."
          }
        }
      }
    },
    "interview.playQuestion": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問を聞く・もう一度聞く"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengarkan / ulangi pertanyaan"
          }
        }
      }
    },
    "interview.stopQuestion": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問音声を止める"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentikan pertanyaan"
          }
        }
      }
    },
    "interview.ready": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問を聞き終わりました。回答してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertanyaan selesai. Silakan menjawab."
          }
        }
      }
    },
    "interview.listenFirst": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず質問音声を最後まで聞いてください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengarkan pertanyaan sampai selesai terlebih dahulu."
          }
        }
      }
    },
    "interview.japaneseHint": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日本語のヒント"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Petunjuk bahasa Jepang"
          }
        }
      }
    },
    "interview.writtenAnswer": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答（インドネシア語）"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban (bahasa Indonesia)"
          }
        }
      }
    },
    "interview.saved": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答を端末に保存しました。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban disimpan di perangkat."
          }
        }
      }
    },
    "interview.writtenPolicy": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この練習は録音しません。回答は削除するまで端末に保存します。採点は準備中で、回答を外部へ送信しません。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan ini tidak merekam suara. Jawaban disimpan di perangkat sampai Anda menghapusnya. Penilaian belum tersedia; jawaban tidak dikirim ke luar perangkat."
          }
        }
      }
    },
    "oral.error.questionAudio": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問音声を再生できませんでした。端末のインドネシア語音声と音声出力を確認し、もう一度再生してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertanyaan tidak dapat diputar. Periksa suara bahasa Indonesia dan keluaran audio perangkat, lalu coba lagi."
          }
        }
      }
    },
    "interview.question.b": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報告書の提出が遅れそうなとき、どう対応しますか。状況の伝え方と、具体的な解決策を説明してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang akan Anda lakukan jika laporan Anda tidak dapat selesai tepat waktu? Jelaskan bagaimana Anda menyampaikan situasinya dan solusi konkret yang akan Anda tawarkan."
          }
        }
      }
    },
    "interview.question.a": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "在宅勤務を増やすとチームの連携が弱くなるという意見をどう考えますか。利点と課題を比較し、具体例を交えて対策を説明してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagaimana pendapat Anda tentang anggapan bahwa bekerja dari rumah dapat melemahkan kerja sama tim? Bandingkan manfaat dan tantangannya, lalu jelaskan solusi dengan contoh konkret."
          }
        }
      }
    },
    "oral.error.restricted": {
      "localizations": {
        "ja": { "stringUnit": { "state": "translated", "value": "この端末では音声認識が制限されています。端末の管理設定を確認してください。" } },
        "id": { "stringUnit": { "state": "translated", "value": "Pengenalan ucapan dibatasi di perangkat ini. Periksa pengaturan pengelolaan perangkat." } }
      }
    },
    "oral.speech": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スピーチ練習"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan pidato"
          }
        }
      }
    },
    "oral.interview": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "面接練習"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan wawancara"
          }
        }
      }
    },
    "oral.detail": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話した内容を端末内で文字にします"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah ucapan menjadi teks di perangkat"
          }
        }
      }
    },
    "oral.policy": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声は端末内だけで文字起こしします。録音は保存・提出・破棄・課題終了時に削除され、異常終了時は次回起動時に削除されます。テキストは削除操作をするまで端末に残ります。採点を有効にした後も、Claudeへ送るのは確認したテキストと設問だけです。発音・抑揚・流暢さは採点しません。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio ditranskripsikan hanya di perangkat. Rekaman dihapus saat menyimpan, mengirim, membuang, atau menutup tugas; sisa rekaman setelah aplikasi berhenti mendadak dihapus saat dibuka kembali. Teks disimpan di perangkat sampai Anda menghapusnya. Setelah penilaian diaktifkan, hanya teks yang Anda konfirmasi dan soal yang dikirim ke Claude. Pelafalan, intonasi, dan kelancaran tidak dinilai."
          }
        }
      }
    },
    "oral.start": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "説明に同意して録音を開始"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setuju dan mulai merekam"
          }
        }
      }
    },
    "oral.rerecord": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録り直す（旧音声を削除）"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam ulang (hapus audio lama)"
          }
        }
      }
    },
    "oral.stop": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止して文字起こし"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berhenti dan transkripsikan"
          }
        }
      }
    },
    "oral.play": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音を再生"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Putar rekaman"
          }
        }
      }
    },
    "oral.transcript": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしを確認・修正"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa dan koreksi transkripsi"
          }
        }
      }
    },
    "oral.confirm": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容を確認しました"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya sudah memeriksa isinya"
          }
        }
      }
    },
    "oral.submit": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認したテキストを提出"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim teks yang dikonfirmasi"
          }
        }
      }
    },
    "oral.save": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認したテキストを保存"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan teks yang dikonfirmasi"
          }
        }
      }
    },
    "oral.saved": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストを端末に保存しました。音声は削除済みです。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks tersimpan di perangkat. Audio sudah dihapus."
          }
        }
      }
    },
    "oral.pendingNotice": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音と文字起こしを練習できます。採点は準備中のため、テキストを端末に保存します。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat berlatih merekam dan mentranskripsikan. Penilaian sedang disiapkan; teks disimpan di perangkat."
          }
        }
      }
    },
    "oral.result": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIによる参考評価"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penilaian referensi oleh AI"
          }
        }
      }
    },
    "oral.delete": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声とテキストを破棄"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus audio dan teks"
          }
        }
      }
    },
    "oral.recording": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang merekam"
          }
        }
      }
    },
    "oral.processing": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理中"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang memproses"
          }
        }
      }
    },
    "oral.reload": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存内容を読み直す"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat ulang data tersimpan"
          }
        }
      }
    },
    "oral.error.permission": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクまたは音声認識が許可されていません。設定で許可してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon atau pengenalan ucapan belum diizinkan. Izinkan melalui Pengaturan."
          }
        }
      }
    },
    "oral.error.unavailable": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末ではインドネシア語の端末内認識を利用できません。音声は送信していません。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengenalan bahasa Indonesia di perangkat tidak tersedia. Audio tidak dikirim."
          }
        }
      }
    },
    "oral.error.recording": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音または再生を開始できません。もう一度お試しください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman atau pemutaran gagal. Silakan coba lagi."
          }
        }
      }
    },
    "oral.error.recognition": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしが完了しませんでした。再生して確認するか、録り直してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripsi gagal. Periksa rekaman atau rekam ulang."
          }
        }
      }
    },
    "oral.error.storage": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストを保存・読み込みできませんでした。保存できるまで提出しません。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks tidak dapat disimpan atau dimuat. Pengiriman menunggu penyimpanan berhasil."
          }
        }
      }
    },
    "oral.error.cleanup": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声を削除できませんでした。再試行してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio tidak dapat dihapus. Silakan coba lagi."
          }
        }
      }
    },
    "oral.prompt.speaking.b": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仕事で改善したいことを一つ挙げ、理由と具体的な改善案をインドネシア語で説明してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebutkan satu hal yang ingin diperbaiki di tempat kerja. Jelaskan alasan dan usulan konkretnya dalam bahasa Indonesia."
          }
        }
      }
    },
    "oral.prompt.interview.b": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同僚から「報告書の提出が遅れそうなとき、どう対応しますか」と質問されました。状況の伝え方と解決策をインドネシア語で答えてください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekan bertanya, “Apa yang Anda lakukan jika laporan akan terlambat?” Jawab dalam bahasa Indonesia: bagaimana menjelaskan keadaan dan solusinya?"
          }
        }
      }
    },
    "oral.prompt.speaking.a": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "都心の自家用車利用を制限すべきか、立場を明確にして、二つの根拠と想定される反論への回答をインドネシア語で述べてください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Haruskah penggunaan mobil pribadi dibatasi di pusat kota? Sampaikan posisi Anda, dua alasan, dan tanggapan terhadap argumen lawan dalam bahasa Indonesia."
          }
        }
      }
    },
    "oral.prompt.interview.a": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "面接官から「在宅勤務を増やすと連携が弱くなるという意見をどう考えますか」と聞かれました。利点と課題を比較し、具体例を交えて対策をインドネシア語で答えてください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pewawancara bertanya, “Bagaimana pendapat Anda bahwa bekerja dari rumah melemahkan kerja sama?” Bandingkan manfaat dan tantangannya, lalu usulkan solusi dengan contoh konkret dalam bahasa Indonesia."
          }
        }
      }
    },
